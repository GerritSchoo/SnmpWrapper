{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug (Linux / WSL)",
      "description": "Ninja, Debug; build output in ./build/debug (inside the project). Net-SNMP from ~/netsnmp or the system (apt libsnmp-dev).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "$env{HOME}/netsnmp",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release (Linux / WSL)",
      "inherits": "debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "shared",
      "displayName": "Debug, shared library",
      "inherits": "debug",
      "cacheVariables": { "BUILD_SHARED_LIBS": "ON" }
    },
    {
      "name": "coverage",
      "displayName": "Debug with line / branch coverage (gcov)",
      "description": "Build output in ./build/coverage; scripts/coverage.sh runs all tests and writes an HTML report.",
      "inherits": "debug",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "--coverage -O0",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage",
        "CMAKE_SHARED_LINKER_FLAGS": "--coverage"
      }
    },
    {
      "name": "asan",
      "displayName": "Debug with AddressSanitizer + UndefinedBehaviorSanitizer",
      "description": "Build output in ./build/asan; finds use-after-free, out-of-bounds access and undefined behaviour in all tests.",
      "inherits": "debug",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=undefined",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "shared", "configurePreset": "shared" },
    { "name": "coverage", "configurePreset": "coverage" },
    { "name": "asan", "configurePreset": "asan" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "shared", "configurePreset": "shared", "output": { "outputOnFailure": true } },
    { "name": "coverage", "configurePreset": "coverage", "output": { "outputOnFailure": true } },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true },
      "environment": {
        "ASAN_OPTIONS": "abort_on_error=1:detect_stack_use_after_return=1",
        "LSAN_OPTIONS": "suppressions=${sourceDir}/test/sanitizer/lsan.supp:print_suppressions=0",
        "UBSAN_OPTIONS": "print_stacktrace=1"
      }
    }
  ]
}
